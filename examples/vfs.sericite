write_file("/notes/todo.txt", "buy milk")
write_file("/notes/ideas.txt", "sericite vm")
print(list_dir("/notes"))
print(read_file("/notes/todo.txt"))
print(path_exists("/notes"))

fs = VFS()
fs.write_file("/config.txt", "preset from parent")
sub = VM("print(read_file(\"/config.txt\"))\nwrite_file(\"/result.txt\", \"done\")", fs=fs)
print(sub.run())
fs = sub.take_fs()
print(fs.read_file("/result.txt"))
print(path_exists("/config.txt"))
