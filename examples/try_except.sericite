try:
    x = 1 / 0
except zero_division as e:
    print("caught: " + e.message)

def f():
    return missing_thing + 1

try:
    f()
except name_error as e:
    print("caught across frames")
    for frame in e.frames:
        print(frame.function, frame.line)

try:
    read_file("/missing.txt")
except file_error as e:
    print("file alias caught: " + e.kind)

try:
    values = []
    print(values[0])
except lookup_error as e:
    print("lookup alias caught: " + e.kind)

i = 0
caught = 0
while i < 3:
    try:
        x = 10 / i
    except zero_division:
        caught = caught + 1
    i = i + 1
print(caught)
