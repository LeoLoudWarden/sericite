# Records and dot member access: schemas are runtime values; labels live only at compile time.

class Point:
    x: int
    y: int

# Construction: positional arguments follow declaration order; keywords work too
p = Point(1, 2)
q = Point(x=3, y=4)
print(p.x, p.y)              # 1 2

# Dot-assignment writes a member, still contract-checked (p.x = "s" raises contract_error)
p.x = 10
print(p)                     # record(x=10, y=2)

# Annotations are runtime contracts that actually execute, width-checked: a record with extra fields is accepted
def dist_from_origin(pt: Point) -> int:
    return pt.x * pt.x + pt.y * pt.y

print(dist_from_origin(q))   # 25

# Peel and wrap: record <-> dict
d = unwrap(p)
print(d)                     # {'x': 10, 'y': 2}
r = wrap(Point, d)
print(r == p)                # True (structural equality)

# A dict carries no contract — even a matching shape cannot fill a contract position
try:
    dist_from_origin({"x": 1, "y": 2})
except contract_error as e:
    print("rejected:", e.message)

# The missing-field error carries the compile-time label
try:
    print(p.z)
except attribute_error as e:
    print("missing:", e.message)
