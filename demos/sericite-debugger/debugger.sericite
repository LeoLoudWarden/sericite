from debugger_lib import display
from debugger_lib import session as control


def copy_library(fs, source="/debugger_lib", target="/debugger_lib"):
    fs.make_dir(target)
    for name in list_dir(source):
        source_path = f"{source}/{name}"
        target_path = f"{target}/{name}"
        try:
            text = read_file(source_path)
        except is_directory:
            copy_library(fs, source_path, target_path)
        else:
            fs.write_file(target_path, text)


def make_target(source):
    fs = VFS()
    copy_library(fs)
    return VM(
        source,
        fs=fs,
        max_instructions=20000,
        max_output_bytes=65536,
        max_frames=100,
        max_string_bytes=262144,
        max_total_bytes=16777216,
    )


def print_banner():
    print(f"╭─ {'SERICITE DEBUGGER ':─<67}")
    print("│ One Sericite program debugging another.")
    print(f"{'╰':─<70}")


def read_command(prompt):
    print(prompt, end="")
    try:
        return input()
    except input_error:
        print("\ninput closed")
        return None


def run_debugger(sub, source, source_lines):
    state = control.new_state()
    print_banner()
    display.print_help()
    snapshot = sub.snapshot()
    display.render(snapshot, source_lines, source, state["watch"])
    try:
        while snapshot["state"] == "ready" or snapshot["state"] == "waiting_input":
            if snapshot["state"] == "waiting_input":
                child_input = read_command("\n[child stdin] ")
                if child_input == None:
                    break
                sub.feed_input(child_input)
                snapshot = sub.snapshot()
                continue
            command = read_command("\n[Enter/i/c/r/w/q/h] ")
            if command == None:
                break
            command = command.strip()
            if command == "":
                snapshot = control.step_statement(sub, state)
            elif command == "i":
                snapshot = control.step_instruction(sub, state)
            elif command == "c":
                snapshot = control.continue_to_watchpoint(sub, state)
            elif command == "r":
                snapshot = control.run_without_watchpoints(sub, state)
            elif command == "q":
                sub.terminate()
                snapshot = sub.snapshot()
            elif command == "h":
                display.print_help()
                continue
            elif command == "w off":
                state["watch"] = ""
                state["watch_hit"] = False
                print("watchpoint disabled")
                continue
            else:
                parts = command.split()
                if len(parts) == 2 and parts[0] == "w":
                    state["watch"] = parts[1]
                    state["watch_hit"] = False
                    print(f"watchpoint armed: {parts[1]}")
                    continue
                print("unknown command; h shows help")
                continue
            display.show_watchpoint(state)
            display.render(snapshot, source_lines, source, state["watch"])
        print(f"session ended · {snapshot['state']}")
    finally:
        sub.dispose()


if len(argv) < 2:
    print("usage: debugger.sericite SOURCE [INPUT] [TARGET_ARG ...]")
    print("SOURCE is Sericite code, not a filename.")
else:
    target_argv = ["<target>"] + argv[3:]
    source = f"argv = {target_argv!r}\n{argv[1]}"
    source_lines = source.splitlines()
    try:
        sub = make_target(source)
    except syntax_error as e:
        print(f"target syntax_error: {e.message}")
    else:
        if len(argv) > 2:
            for line in argv[2].splitlines():
                sub.feed_input(line)
        run_debugger(sub, source, source_lines)
