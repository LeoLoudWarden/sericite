MAX_VALUE_CHARS = 96
STDOUT_TAIL_LINES = 5
SOURCE_WINDOW_LINES = 11


def compact(value):
    text = repr(value)
    if len(text) > MAX_VALUE_CHARS:
        return f"{text[:MAX_VALUE_CHARS]} …"
    return text


def line_number(value):
    if value == None:
        return "-"
    return f"{value}"


def print_help():
    print("  Enter  execute one source statement")
    print("  i      execute one internal instruction")
    print("  c      continue to a breakpoint, watchpoint, input wait, or terminal state")
    print("  b LINE set a breakpoint; b off LINE removes it; b lists them")
    print("  w NAME watch a local in the current frame; w off disables it")
    print("  r      run without watchpoints; breakpoints stay active")
    print("  q      terminate the child VM")
    print("  h      show this help")


def render_source(snapshot, source_lines):
    print(f"├─ {'SOURCE ':─<67}")
    focus = snapshot["next_line"]
    marker = ">"
    if focus == None and snapshot["error"] != None:
        focus = snapshot["error"]["line"]
        marker = "!"
    if focus == None:
        focus = 1
    total = len(source_lines)
    start = 1
    end = total
    if total > SOURCE_WINDOW_LINES:
        start = focus - 4
        if start < 1:
            start = 1
        end = start + SOURCE_WINDOW_LINES - 1
        if end > total:
            end = total
            start = total - SOURCE_WINDOW_LINES + 1
    if start > 1:
        print(f"│     …  {start - 1} earlier lines")
    index = start
    while index <= end:
        prefix = "  "
        if index == focus:
            prefix = f"{marker} "
        print(f"│ {prefix}{index:3}  {source_lines[index - 1]}")
        index = index + 1
    if end < total:
        print(f"│     …  {total - end} later lines")


def render(snapshot, source_lines, source, watch):
    print(f"\n╭─ {'CHILD VM ':─<67}")
    print(
        f"│ state {snapshot['state']} · instructions "
        f"{snapshot['instruction_count']} · last "
        f"{line_number(snapshot['last_line'])} → next "
        f"{line_number(snapshot['next_line'])}"
    )
    if watch == "":
        watch = "off"
    print(f"│ target {len(source)} chars · watch {watch}")
    if snapshot["breakpoint"] != None:
        print(f"│ breakpoint hit · line {snapshot['breakpoint']['line']}")
    render_source(snapshot, source_lines)
    print(f"├─ {'LOCALS · current frame ':─<67}")
    locals_view = snapshot["locals"]
    if len(locals_view) == 0:
        print("│ (empty)")
    for name in locals_view:
        print(f"│ {name} = {compact(locals_view[name])}")
    print(f"├─ {'CHILD STDOUT · tail ':─<67}")
    output_lines = snapshot["stdout"].splitlines()
    if len(output_lines) == 0:
        print("│ (empty)")
    start = 0
    if len(output_lines) > STDOUT_TAIL_LINES:
        start = len(output_lines) - STDOUT_TAIL_LINES
    for line in output_lines[start:]:
        print(f"│ {line}")
    if snapshot["error"] != None:
        print(f"├─ {'ERROR · safe snapshot ':─<67}")
        print(f"│ {snapshot['error']['kind']}: {snapshot['error']['message']}")
        for frame in snapshot["error"]["frames"]:
            print(f"│ {frame['function']}:{line_number(frame['line'])}")
    print(f"{'╰':─<70}")


def show_watchpoint(state):
    if not state["watch_hit"]:
        return
    print(f"\n◆ watchpoint hit · {state['watch']}")
    before = "(not in frame)"
    after = "(not in frame)"
    if state["before_present"]:
        before = compact(state["before_value"])
    if state["after_present"]:
        after = compact(state["after_value"])
    print(f"  before: {before}")
    print(f"  after:  {after}")
    state["watch_hit"] = False
