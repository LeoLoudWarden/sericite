CASE_INSTRUCTION_LIMIT = 120000
CASE_OUTPUT_LIMIT = 512


def run_case(source, input_text):
    fs = VFS()
    fs.write_file("/input.txt", input_text)
    sub = VM(
        "",
        fs=fs,
        max_instructions=CASE_INSTRUCTION_LIMIT,
        max_output_bytes=CASE_OUTPUT_LIMIT,
        max_frames=64,
        max_descendant_vms=0,
        max_list_size=4096,
        max_dict_size=256,
        max_string_bytes=8192,
        max_total_bytes=1048576,
        max_fs_files=8,
        max_fs_file_bytes=4096,
    )
    result = {"ok": False, "instructions": 0, "output": "", "error": ""}
    harvested = False
    try:
        sub.exec(source)
        snapshot = sub.snapshot()
        if snapshot["state"] == "waiting_input":
            result["error"] = "input_error"
        else:
            result["instructions"] = snapshot["instruction_count"]
            fs = sub.take_fs()
            harvested = True
            result["output"] = fs.read_file("/output.txt")
            result["ok"] = True
    except ... as e:
        result["error"] = e.kind
    finally:
        if sub.snapshot()["state"] == "waiting_input":
            sub.terminate()
        if not harvested:
            fs = sub.take_fs()
        sub.dispose()
    return result


def error_note(kind):
    if kind == "resource_exhausted":
        return "stopped by the VM quota"
    if kind == "file_not_found":
        return "judge and host files are not visible"
    return "submission failed inside its own VM"
