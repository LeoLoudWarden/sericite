from arena_lib.cases import expected_tokens, make_cases
from arena_lib.judge import CASE_INSTRUCTION_LIMIT, error_note, run_case

CASES = make_cases()


def contestant_name(filename):
    return filename[3:len(filename) - 9]


def insert_ranked(ranked, result):
    ranked.append(result)
    index = len(ranked) - 1
    while index > 0:
        if ranked[index - 1]["instructions"] <= result["instructions"]:
            break
        ranked[index] = ranked[index - 1]
        index = index - 1
    ranked[index] = result


def print_header(entry_count):
    print("╭──────────────────────────────────────────────────────────────────────╮")
    print("│  SERICITE / SORTING ARENA                                            │")
    print("│  Untrusted code in. Correct answers and instruction counts out.      │")
    print("╰──────────────────────────────────────────────────────────────────────╯")
    print(
        f"  {entry_count} submissions · {len(CASES)} test cases · "
        f"{CASE_INSTRUCTION_LIMIT:,}-instruction ceiling per case"
    )
    print("  Every submission gets a fresh VM. No network, host files, or shared state.")
    print("  Fresh random cases from Python random_int · granted to the judge only")


def judge_entry(source, name):
    print(f"\n  {name}")
    print("  " + "────────────────────────────────────────────────────────────────")
    total = 0
    accepted = True
    failure = ""
    for case in CASES:
        result = run_case(source, case["input"])
        if not result["ok"]:
            accepted = False
            failure = result["error"]
            print(f"    × {case['name']:16}{failure} · {error_note(failure)}")
            break
        if result["output"].split() != case["expected"]:
            accepted = False
            failure = "wrong_answer"
            print(f"    × {case['name']:16}wrong answer")
            break
        total = total + result["instructions"]
        print(f"    ✓ {case['name']:16}{result['instructions']:9,} instructions")
    if accepted:
        print(f"    → qualified · {total:,} instructions total")
    return {"name": name, "instructions": total, "error": failure, "ok": accepted}


def print_standings(qualified, rejected):
    print("\n╭─ FINAL STANDINGS ────────────────────────────────────────────────────╮")
    print("  RANK  CONTESTANT                  TOTAL INSTRUCTIONS")
    rank = 1
    for result in qualified:
        print(f"  {rank:<6}{result['name']:24}{result['instructions']:,}")
        rank = rank + 1
    for result in rejected:
        print(f"  {'DQ':6}{result['name']:24}{result['error']}")
    print("╰──────────────────────────────────────────────────────────────────────╯")
    print("  The arena survived every submission. The scoreboard only counts correct code.")


for case in CASES:
    case["expected"] = expected_tokens(case["input"])

entries = list_dir("/entries")
qualified = []
rejected = []
print_header(len(entries))
for filename in entries:
    source = read_file(f"/entries/{filename}")
    result = judge_entry(source, contestant_name(filename))
    if result["ok"]:
        insert_ranked(qualified, result)
    else:
        rejected.append(result)
print_standings(qualified, rejected)
