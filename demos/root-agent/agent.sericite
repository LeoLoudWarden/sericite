# Root replaces the old Python main.py and runs the outer session itself.
DOC_PATH = "/sericite语言特性速览.md"
MAX_RESULT_CHARS = 4000
MAX_ROUNDS = 30

TOOLS = [
    {
        "type": "function",
        "function": {
            "name": "sericite_exec",
            "description": "在当前工作空间执行一段 sericite 代码，返回其标准输出。",
            "parameters": {
                "type": "object",
                "properties": {
                    "code": {"type": "string", "description": "sericite 源码"}
                },
                "required": ["code"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "file_read",
            "description": "读取工作目录中的一个文本文件。",
            "parameters": {
                "type": "object",
                "properties": {"path": {"type": "string"}},
                "required": ["path"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "file_write",
            "description": "向工作目录写入一个文本文件（覆盖）。",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "content": {"type": "string"},
                },
                "required": ["path", "content"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "file_list",
            "description": "列出工作目录中的文件。",
            "parameters": {
                "type": "object",
                "properties": {"path": {"type": "string"}},
                "required": ["path"],
            },
        },
    },
]


def norm_path(path):
    if not path or path == ".":
        return "/"
    if path[0] != "/":
        path = "/" + path
    return path


def workspace_path(path):
    path = norm_path(path)
    if path == "/":
        return "/workspace"
    return "/workspace" + path


def seed_tree(sub, prefix="/"):
    for name in list_dir(workspace_path(prefix)):
        path = prefix.rstrip("/") + "/" + name
        try:
            text = read_file(workspace_path(path))
        except is_directory:
            seed_tree(sub, path)
        else:
            sub.write_file(path, text)


def layer_1_output(text):
    print("[外层VM实时] " + repr(text))


# One persistent execution VM for the whole session: variables, definitions,
# and files all survive across sericite_exec calls, and the file tools below
# operate on this VM's filesystem directly. Its output is forwarded live while
# remaining buffered for sericite_exec tool results.
sub = VM(
    "",
    functions={"llm_chat": llm_chat, "http_get": http_get},
    output_writer=layer_1_output,
)
seed_tree(sub)


def exec_error(kind, message):
    return "(" + kind + ": " + message + ")"


def execute_code(code):
    try:
        output = sub.exec(code)
    except arity_error as e:
        return exec_error("arity_error", e)
    except attribute_error as e:
        return exec_error("attribute_error", e)
    except contract_error as e:
        return exec_error("contract_error", e)
    except conversion_error as e:
        return exec_error("conversion_error", e)
    except ffi_error as e:
        return exec_error("ffi_error", e)
    except file_not_found as e:
        return exec_error("file_not_found", e)
    except index_error as e:
        return exec_error("index_error", e)
    except input_error as e:
        return exec_error("input_error", e)
    except is_directory as e:
        return exec_error("is_directory", e)
    except key_error as e:
        return exec_error("key_error", e)
    except name_error as e:
        return exec_error("name_error", e)
    except not_directory as e:
        return exec_error("not_directory", e)
    except raise_error as e:
        return exec_error("raise_error", e)
    except runtime_error as e:
        return exec_error("runtime_error", e)
    except syntax_error as e:
        return exec_error("syntax_error", e)
    except type_error as e:
        return exec_error("type_error", e)
    except zero_division as e:
        return exec_error("zero_division", e)
    return output[:MAX_RESULT_CHARS] or "(no output)"


def dispatch_tool(name, args):
    if name == "sericite_exec":
        return execute_code(args.get("code", ""))
    if name == "file_read":
        path = norm_path(args.get("path", ""))
        try:
            return sub.read_file(path)
        except file_not_found:
            return "(no such file: " + path + ")"
    if name == "file_write":
        sub.write_file(norm_path(args["path"]), args["content"])
        return "(written)"
    if name == "file_list":
        path = norm_path(args.get("path", "/"))
        try:
            return "\n".join(sub.list_dir(path)) or "(empty)"
        except file_not_found:
            return "(no such file: " + path + ")"
    return "(unknown tool: " + name + ")"


messages = [
    {"role": "system", "content": read_file("/control/prompt_outer.txt")},
    {"role": "user", "content": "开始吧"},
]
final = "(达到最大轮数)"
rounds = 0
while rounds < MAX_ROUNDS:
    resp = llm_chat({"messages": messages, "tools": TOOLS})
    if resp["content"]:
        print("[外层 第" + str(rounds + 1) + "轮] " + resp["content"])
    messages.append(resp["assistant_message"])
    calls = resp["tool_calls"]
    if len(calls) == 0:
        final = resp["content"]
        break
    for call in calls:
        print("[外层 工具调用] " + call["name"])
        call_args = call["args"]
        for k in call_args.keys():
            v = call_args[k]
            print("[外层 工具参数(" + k + ")] " + repr(v))
        result = dispatch_tool(call["name"], call["args"])
        print("[外层 工具结果] " + repr(result))
        messages.append(
            {"role": "tool", "tool_call_id": call["id"], "content": result}
        )
    rounds = rounds + 1

print("\n=== 外层会话最终回答 ===")
print(final)
