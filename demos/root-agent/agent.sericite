# Root replaces the old Python main.py and runs the outer session itself.
DOC_PATH = "/sericite语言特性速览.md"
MAX_RESULT_CHARS = 4000
MAX_ROUNDS = 30
MAX_LIVE_LINES = 8
MAX_LIVE_LINE_CHARS = 240
LIVE_TAIL_LINES = 3
VERBOSE = "--verbose" in argv
live = {"chars": 0, "lines": 0, "shown": 0, "folded": False, "tail": []}
exec_feedback = {"truncations": 0}

TOOLS = [
    {
        "type": "function",
        "function": {
            "name": "sericite_exec",
            "description": "在当前工作空间执行一段 sericite 代码，返回其标准输出。",
            "parameters": {
                "type": "object",
                "properties": {
                    "code": {"type": "string", "description": "sericite 源码"}
                },
                "required": ["code"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "file_read",
            "description": "读取工作目录中的一个文本文件。",
            "parameters": {
                "type": "object",
                "properties": {"path": {"type": "string"}},
                "required": ["path"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "file_write",
            "description": "向工作目录写入一个文本文件（覆盖）。",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "content": {"type": "string"},
                },
                "required": ["path", "content"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "file_list",
            "description": "列出工作目录中的文件。",
            "parameters": {
                "type": "object",
                "properties": {"path": {"type": "string"}},
                "required": ["path"],
            },
        },
    },
]


def norm_path(path):
    if not path or path == ".":
        return "/"
    if path[0] != "/":
        path = f"/{path}"
    return path


def workspace_path(path):
    path = norm_path(path)
    if path == "/":
        return "/workspace"
    return f"/workspace{path}"


def seed_tree(sub, prefix="/"):
    for name in list_dir(workspace_path(prefix)):
        path = f"{prefix.rstrip('/')}/{name}"
        try:
            text = read_file(workspace_path(path))
        except is_directory:
            seed_tree(sub, path)
        else:
            sub.write_file(path, text)


def print_live_line(line):
    if len(line) > MAX_LIVE_LINE_CHARS:
        line = f"{line[:MAX_LIVE_LINE_CHARS]} …"
    print(f"vm 1  {line}")


def layer_1_output(text):
    lines = text.splitlines()
    live["chars"] += len(text)
    live["lines"] += len(lines)
    for line in lines:
        live["tail"].append(line)
        if len(live["tail"]) > LIVE_TAIL_LINES:
            live["tail"].pop(0)
        if VERBOSE:
            print(f"vm 1  {line}")
        elif live["shown"] < MAX_LIVE_LINES:
            print_live_line(line)
            live["shown"] += 1
        elif not live["folded"]:
            live["folded"] = True
            print("vm 1  … folding live output; tail follows")


# One persistent execution VM for the whole session: variables, definitions,
# and files all survive across sericite_exec calls, and the file tools below
# operate on this VM's filesystem directly. Its output is forwarded live while
# remaining buffered for sericite_exec tool results.
sub = VM(
    "",
    functions={"llm_chat": llm_chat, "http_get": http_get},
    output_writer=layer_1_output,
)
seed_tree(sub)


def exec_error(kind, message):
    return f"({kind}: {message})"


def finish_live_output():
    if not VERBOSE and live["folded"]:
        print(
            f"vm 1  … display folded · {live['chars']} chars / "
            f"{live['lines']} lines total"
        )
        for line in live["tail"]:
            print_live_line(line)


def truncate_output(output):
    exec_feedback["truncations"] += 1
    total = len(output)
    if exec_feedback["truncations"] == 1:
        print(
            f"root  ↳ output truncated · {total} chars · "
            "suggested write_file + file_read"
        )
        advice = (
            f"提示：本次输出共 {total} 字符，仅返回前 {MAX_RESULT_CHARS} 字符。"
            "处理大文本时，请用 write_file 将完整内容写入当前工作区，"
            "再使用 file_read 工具读取。"
        )
    else:
        print(
            f"root  ↳ output truncated again · {total} chars · "
            "use write_file + file_read"
        )
        advice = (
            f"再次截断：本次输出共 {total} 字符，仍只返回前 {MAX_RESULT_CHARS} 字符。"
            "请不要重复打印或重跑大段输出；请用 write_file 写入当前工作区，"
            "再改用 file_read 工具。"
        )
    return f"{output[:MAX_RESULT_CHARS]}\n\n[{advice}]"


def execute_code(code):
    live["chars"] = 0
    live["lines"] = 0
    live["shown"] = 0
    live["folded"] = False
    live["tail"] = []
    try:
        output = sub.exec(code)
    except ... as e:
        finish_live_output()
        return exec_error(e.kind, e.message)
    finish_live_output()
    if not output:
        return "(no output)"
    if len(output) > MAX_RESULT_CHARS:
        return truncate_output(output)
    return output


def dispatch_tool(name, args):
    if name == "sericite_exec":
        return execute_code(args.get("code", ""))
    if name == "file_read":
        path = norm_path(args.get("path", ""))
        try:
            return sub.read_file(path)
        except file_not_found:
            return f"(no such file: {path})"
    if name == "file_write":
        sub.write_file(norm_path(args["path"]), args["content"])
        return "(written)"
    if name == "file_list":
        path = norm_path(args.get("path", "/"))
        try:
            return "\n".join(sub.list_dir(path)) or "(empty)"
        except file_not_found:
            return f"(no such file: {path})"
    return f"(unknown tool: {name})"


def tool_summary(name, args):
    if name == "sericite_exec":
        code = args.get("code", "")
        return f"{name} · {len(code.splitlines())} lines"
    path = norm_path(args.get("path", ""))
    if name == "file_write":
        return f"{name} {path} · {len(args.get('content', ''))} chars"
    return f"{name} {path}"


def print_tool_result(name, result):
    if result[:1] == "(":
        print(f"root  ↳ {result}")
    elif name == "file_read":
        print(f"root  ↳ {len(result)} chars · full result sent to model")
    elif name == "file_list":
        print(f"root  ↳ {len(result.splitlines())} entries")


messages = [
    {"role": "system", "content": read_file("/control/prompt_outer.txt")},
    {"role": "user", "content": "开始吧"},
]
final = "(达到最大轮数)"
rounds = 0
while rounds < MAX_ROUNDS:
    print(f"\n── outer round {rounds + 1} ─────────────────")
    resp = llm_chat({"messages": messages, "tools": TOOLS})
    messages.append(resp["assistant_message"])
    calls = resp["tool_calls"]
    if len(calls) == 0:
        final = resp["content"]
        break
    if resp["content"]:
        print(f"model  {resp['content']}")
    for call in calls:
        call_args = call["args"]
        if VERBOSE:
            print(f"root  {call['name']}")
            for k in call_args.keys():
                print(f"root  arg {k} = {call_args[k]!r}")
        else:
            print(f"root  {tool_summary(call['name'], call_args)}")
        result = dispatch_tool(call["name"], call_args)
        if VERBOSE:
            print(f"root  result = {result!r}")
        else:
            print_tool_result(call["name"], result)
        messages.append(
            {"role": "tool", "tool_call_id": call["id"], "content": result}
        )
    rounds = rounds + 1

print("\n── final ─────────────────────────")
print(final)
